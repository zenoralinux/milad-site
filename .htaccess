DirectoryIndex index.php index.html
Options -Indexes
RewriteEngine On

# Route the legacy static entry file to the PHP-rendered homepage when PHP is enabled.
RewriteRule ^index\.html$ index.php [R=302,L]
RewriteRule ^admin/?$ admin/index.php [L,QSA]
RewriteRule ^api/admin/?$ api/admin.php [L,QSA]

# Keep application internals, configuration, SQL, and runtime storage private.
RewriteRule ^(?:app|bin|config|database|storage|docs|\.git)(?:/|$) - [F,L]

<FilesMatch "^(config\.php|config\.example\.php|config\.local\.php|\.env|composer\.(json|lock)|.*\.sql)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
</IfModule>
